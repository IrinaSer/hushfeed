{
  "name": "hushfeed",
  "displayName": "Hushfeed",
  "version": "0.0.1",
  "description": "Your feed, just quieter.",
  "author": "Silverina",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "happy-dom": "20.14.5",
    "prettier": "3.2.4",
    "typescript": "5.3.3",
    "vitest": "5.0.3"
  },
  "manifest": {
    "permissions": [
      "storage"
    ],
    "host_permissions": [
      "https://*/*"
    ]
  }
}
